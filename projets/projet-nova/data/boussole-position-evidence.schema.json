{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.benoitcantin.com/projets/projet-nova/data/boussole-position-evidence.schema.json",
  "title": "Boussole Nova — preuve de position politique",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "partyId",
    "questionId",
    "status",
    "score",
    "confidence",
    "sources",
    "rationale",
    "reviews"
  ],
  "properties": {
    "partyId": {
      "type": "string",
      "minLength": 1
    },
    "questionId": {
      "type": "string",
      "pattern": "^q[0-9]{2}$"
    },
    "status": {
      "enum": [
        "known",
        "ambiguous",
        "unknown",
        "contradictory"
      ]
    },
    "score": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": -3,
      "maximum": 3
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        "none"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "sourceType",
          "publishedAt",
          "checkedAt"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "sourceType": {
            "enum": [
              "election_platform",
              "official_policy_document",
              "party_or_leader_press_release",
              "official_legislative_or_parliamentary_statement",
              "statement_from_elected_party_representative",
              "party_constitution_or_member_resolution"
            ]
          },
          "publishedAt": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "checkedAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      }
    },
    "rationale": {
      "type": "string"
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewerId",
          "decision",
          "reviewedAt"
        ],
        "properties": {
          "reviewerId": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "agree",
              "disagree",
              "needs_more_evidence"
            ]
          },
          "reviewedAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "known"
          }
        }
      },
      "then": {
        "properties": {
          "score": {
            "type": "integer"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "unknown",
              "ambiguous",
              "contradictory"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "score": {
            "type": "null"
          }
        }
      }
    }
  ]
}
